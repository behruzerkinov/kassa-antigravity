# Kassa POS — Environment Configuration Template
# IMPORTANT: Provide actual values in your local .env file. Never commit real credentials.

# -----------------------------------------------------------------------------
# Cloud Sync & Firestore Configuration (Deferred / External Integration)
# -----------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORE_ID=store-tashkent-01
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com

# -----------------------------------------------------------------------------
# Local Application & POS Hardware Defaults
# -----------------------------------------------------------------------------
VITE_DEFAULT_LOCALE=ru
VITE_CURRENCY_SYMBOL=UZS
VITE_DEFAULT_PRINTER_WIDTH=80
VITE_AUTO_LOCK_MINUTES=5
VITE_WEIGHTED_PREFIXES=27,28,29
